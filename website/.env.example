STRIPE_SNIPCOPY_PRO_PRICE_ID="price_replace_me"
STRIPE_PRO_PRICE_ID="price_replace_me"
STRIPE_DRAW_OVERLAY_PRO_PRICE_ID="price_replace_me"
STRIPE_AUDIO_CROP_PRO_PRICE_ID="price_replace_me"
